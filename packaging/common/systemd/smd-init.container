[Unit]
Description=The %N container
PartOf=openchami.target

# NOTE: `Requires` responsibility will be shifted to drop-ins to enable
# packages created from this repo to apply to arbitrary deployment styles.
Wants=postgres.service
After=postgres.service

[Container]
ContainerName=%N
HostName=%N
Image=ghcr.io/openchami/smd:@IMAGE_TAG@
PodmanArgs=--entrypoint='["/bin/sh","-c","/%N"]'

[Service]
Restart=on-failure
Type=oneshot
